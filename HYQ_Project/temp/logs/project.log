132 float oceanFresnel(vec3 N, vec3 V, float smoothness) {
133   float NdotV = max(dot(N, V), 0.0);
134   float power = mix(2.0, 5.0, smoothness);
135   float f0 = 0.02;
136   return f0 + (1.0 - f0) * pow(1.0 - NdotV, power);
137 }
138 vec3 oceanEnvReflection(vec3 N, vec3 V) {
139   vec3 reflectDir = reflect(-V, N);
140   float skyY = max(reflectDir.y, 0.0);
141   vec3 horizonColor = vec3(0.65, 0.75, 0.85);
142   vec3 zenithColor  = vec3(0.15, 0.30, 0.60);
143   float t = pow(skyY, 0.5);
144   vec3 envColor = mix(horizonColor, zenithColor, t);
145   float belowHorizon = smoothstep(0.0, -0.3, reflectDir.y);
146   envColor = mix(envColor, deepColor.rgb * 0.5, belowHorizon);
147   return envColor * envParams.x;
148 }
149 vec3 oceanSSS(vec3 N, vec3 V, vec3 L, float waveHeight) {
150   float strength = surfaceParams.y;
151   if (strength < 0.001) return vec3(0.0);
152   float heightFactor = smoothstep(-0.3, 0.8, waveHeight);
153   float sssView = pow(max(dot(V, -L), 0.0), 3.0);
154   float sssNormal = max(dot(N, L), 0.0);
155   float sssFactor = (sssView * 0.6 + sssNormal * 0.4) * heightFactor * strength;
156   return sssColor.rgb * sssFactor;
157 }
158 float D_GGX(float NoH, float a2) {
159   float denom = NoH * NoH * (a2 - 1.0) + 1.0;
160   return a2 / (3.14159265 * denom * denom + 0.0001);
161 }
162 float G_SmithGGX(float NoV, float NoL, float k) {
163   float gv = NoV / (NoV * (1.0 - k) + k);
164   float gl = NoL / (NoL * (1.0 - k) + k);
165   return gv * gl;
166 }
167 vec3 oceanSpecular(vec3 N, vec3 V, vec3 L) {
168   float intensity = surfaceParams.z;
169   if (intensity < 0.001) return vec3(0.0);
170   float smoothness = surfaceParams.x;
171   float roughness = max(1.0 - smoothness, 0.01);
172   float a = roughness * roughness;
173   float a2 = a * a;
174   float k = (a + 1.0) * (a + 1.0) / 8.0;
175 
176   vec3 H = normalize(V + L);
177   float NoH = max(dot(N, H), 0.0);
178   float NoV = max(dot(N, V), 0.001);
179   float NoL = max(dot(N, L), 0.0);
180   float VoH = max(dot(V, H), 0.0);
181 
182   float D = D_GGX(NoH, a2);
183   float G = G_SmithGGX(NoV, NoL, k);
184   float F = 0.02 + 0.98 * pow(1.0 - VoH, 5.0);
185   float spec = (D * G * F) / max(4.0 * NoV * NoL, 0.001);
186   return cc_mainLitColor.xyz * cc_mainLitColor.w * spec * intensity;
187 }
188 float oceanSparkle(vec2 worldXZ, vec3 N, vec3 V, vec3 L, float time) {
189   float smoothness = surfaceParams.x;
190   if (smoothness < 0.3) return 0.0;
191   vec2 uv = worldXZ * 15.0 + vec2(time * 0.4, time * 0.23);
192   float n = oceanNoise(uv);
193   float sparkle = pow(max(n, 0.0), 10.0) * 40.0;
194   float NoL = max(dot(N, L), 0.0);
195   sparkle *= NoL * smoothness;
196   return sparkle;
197 }
198 
199 
200 float oceanFoam(vec2 worldXZ, float waveHeight, float time) {
201   float amount = waveDetail.w;
202   if (amount < 0.001) return 0.0;
203 
204   float size = max(waveControl.y, 0.01);
205   float foamSize = max(envParams.w, 0.5);
206   vec2 uv = worldXZ / size;
207   float foamFactor = smoothstep(0.1, 0.6, waveHeight / max(waveControl.z, 0.01));
208   float noise1 = oceanNoise(uv * foamSize + vec2(time * 0.2, time * 0.15));
209   float noise2 = oceanNoise(uv * foamSize * 2.2 + vec2(-time * 0.15, time * 0.25));
210   foamFactor *= (0.5 + 0.3 * noise1 + 0.2 * noise2);
211   foamFactor *= smoothstep(0.1, 0.4, foamFactor);
212 
213   return clamp(foamFactor * amount, 0.0, 1.0);
214 }
