110   float h1  = oceanNoise(uv1);
111   float h1x = oceanNoise(uv1 + vec2(eps, 0.0));
112   float h1z = oceanNoise(uv1 + vec2(0.0, eps));
113   float h2  = oceanNoise(uv2);
114   float h2x = oceanNoise(uv2 + vec2(eps, 0.0));
115   float h2z = oceanNoise(uv2 + vec2(0.0, eps));
116 
117   vec3 n;
118   n.x = ((h1 - h1x) / eps) * 0.65 + ((h2 - h2x) / eps) * 0.35;
119   n.z = ((h1 - h1z) / eps) * 0.65 + ((h2 - h2z) / eps) * 0.35;
120   n.y = 0.0;
121   n.xz *= strength;
122   return n;
123 }
