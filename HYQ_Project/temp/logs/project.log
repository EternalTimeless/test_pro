223 vec4 frag() {
224   float time = cc_time.x;
225   vec3 V = normalize(v_viewDir);
226   vec3 L = normalize(-cc_mainLitDir.xyz);
227   float smoothness = surfaceParams.x;
228   vec3 N = normalize(v_waveNormal);
229   vec3 detailNorm = computeDetailNormal(v_worldPos.xz, time);
230   N = normalize(N + vec3(detailNorm.x, 0.0, detailNorm.z));
231   float fresnel = oceanFresnel(N, V, smoothness);
232   vec3 reflection = oceanEnvReflection(N, V);
233   float depthFactor = clamp(exp(-max(-v_waveHeight, 0.0) / max(colorParams.x, 0.1)), 0.0, 1.0);
234   float heightTint = smoothstep(-0.5, 0.5, v_waveHeight / max(waveControl.z, 0.01));
235   vec3 waterColor = mix(deepColor.rgb, shallowColor.rgb, depthFactor * 0.5 + heightTint * 0.5);
236   vec3 sss = oceanSSS(N, V, L, v_waveHeight);
237   vec3 specular = oceanSpecular(N, V, L);
238   float sparkle = oceanSparkle(v_worldPos.xz, N, V, L, time);
239   float foamFactor = oceanFoam(v_worldPos.xz, v_waveHeight, time);
240   vec3 waterFinal = mix(waterColor, reflection, fresnel);
241   waterFinal += sss;
242   waterFinal += specular;
243   waterFinal += cc_mainLitColor.xyz * sparkle;
244   waterFinal = mix(waterFinal, foamColor.rgb, foamFactor);
245   float dist = length(v_worldPos - cc_cameraPos.xyz);
246   float fogFactor = 1.0 - exp(-envParams.y * max(dist - envParams.z, 0.0));
247   fogFactor = clamp(fogFactor, 0.0, 1.0);
248   waterFinal = mix(waterFinal, fogColor.rgb, fogFactor);
249   waterFinal += cc_ambientSky.xyz * (1.0 - fresnel) * 0.15;
250   float alpha = mix(0.55, 0.95, fresnel);
251   alpha = mix(alpha, 1.0, foamFactor);
252   alpha = clamp(alpha, 0.0, 1.0);
253 
254   return CCFragOutput(vec4(waterFinal, alpha));
255 }
