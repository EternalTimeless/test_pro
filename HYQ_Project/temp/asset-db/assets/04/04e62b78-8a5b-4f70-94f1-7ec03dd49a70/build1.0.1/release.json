                    "glsl3": {
                        "vert": "\nprecision highp float;\nlayout(std140) uniform CCGlobal {\n  highp   vec4 cc_time;\n  mediump vec4 cc_screenSize;\n  mediump vec4 cc_nativeSize;\n  mediump vec4 cc_probeInfo;\n  mediump vec4 cc_debug_view_mode;\n};\nlayout(std140) uniform CCCamera {\n  highp   mat4 cc_matView;\n  highp   mat4 cc_matViewInv;\n  highp   mat4 cc_matProj;\n  highp   mat4 cc_matProjInv;\n  highp   mat4 cc_matViewProj;\n  highp   mat4 cc_matViewProjInv;\n  highp   vec4 cc_cameraPos;\n  mediump vec4 cc_surfaceTransform;\n  mediump vec4 cc_screenScale;\n  mediump vec4 cc_exposure;\n  mediump vec4 cc_mainLitDir;\n  mediump vec4 cc_mainLitColor;\n  mediump vec4 cc_ambientSky;\n  mediump vec4 cc_ambientGround;\n  mediump vec4 cc_fogColor;\n  mediump vec4 cc_fogBase;\n  mediump vec4 cc_fogAdd;\n  mediump vec4 cc_nearFar;\n  mediump vec4 cc_viewPort;\n};\nlayout(std140) uniform CCLocal {\n  highp mat4 cc_matWorld;\n  highp mat4 cc_matWorldIT;\n  highp vec4 cc_lightingMapUVParam;\n  highp vec4 cc_localShadowBias;\n  highp vec4 cc_reflectionProbeData1;\n  highp vec4 cc_reflectionProbeData2;\n  highp vec4 cc_reflectionProbeBlendData1;\n  highp vec4 cc_reflectionProbeBlendData2;\n};\nin vec3 a_position;\nin vec3 a_normal;\nin vec2 a_texCoord;\nout vec2 v_uv;\nout float v_worldY;\nout vec3 v_normal;\nout vec3 v_viewDir;\nvoid main () {\n  vec4 world = cc_matWorld * vec4(a_position, 1.0);\n  v_uv = a_texCoord;\n  v_worldY = world.y;\n  v_normal = normalize((cc_matWorldIT * vec4(a_normal, 0.0)).xyz);\n  v_viewDir = normalize(cc_cameraPos.xyz - world.xyz);\n  gl_Position = cc_matProj * cc_matView * world;\n}",
                        "frag": "\nprecision highp float;\nlayout(std140) uniform CCGlobal {\n  highp   vec4 cc_time;\n  mediump vec4 cc_screenSize;\n  mediump vec4 cc_nativeSize;\n  mediump vec4 cc_probeInfo;\n  mediump vec4 cc_debug_view_mode;\n};\nlayout(std140) uniform CCCamera {\n  highp   mat4 cc_matView;\n  highp   mat4 cc_matViewInv;\n  highp   mat4 cc_matProj;\n  highp   mat4 cc_matProjInv;\n  highp   mat4 cc_matViewProj;\n  highp   mat4 cc_matViewProjInv;\n  highp   vec4 cc_cameraPos;\n  mediump vec4 cc_surfaceTransform;\n  mediump vec4 cc_screenScale;\n  mediump vec4 cc_exposure;\n  mediump vec4 cc_mainLitDir;\n  mediump vec4 cc_mainLitColor;\n  mediump vec4 cc_ambientSky;\n  mediump vec4 cc_ambientGround;\n  mediump vec4 cc_fogColor;\n  mediump vec4 cc_fogBase;\n  mediump vec4 cc_fogAdd;\n  mediump vec4 cc_nearFar;\n  mediump vec4 cc_viewPort;\n};\nvec4 CCFragOutput (vec4 color) {\n  return color;\n}\nuniform sampler2D mainTexture;\nlayout(std140) uniform HitFlashParams {\n  vec4 mainColor;\n  vec4 flashColor;\n  float flashProgress;\n  float flashStrength;\n  float edgeWidth;\n  float worldCenterY;\n  float worldHalfY;\n};\nin vec2 v_uv;\nin float v_worldY;\nin vec3 v_normal;\nin vec3 v_viewDir;\nvec4 frag () {\n  float p = clamp(flashProgress, 0.0, 1.0);\n  float fade = 1.0 - smoothstep(0.12, 1.0, p);\n  vec4 baseColor = texture(mainTexture, v_uv) * mainColor;\n  float halfY = max(worldHalfY, 0.001);\n  float yN = clamp((v_worldY - worldCenterY) / halfY, -1.0, 1.0);\n  float topDistance = clamp(1.0 - yN, 0.0, 1.0);\n  float bottomDistance = clamp(1.0 + yN, 0.0, 1.0);\n  float topWidth = edgeWidth * 0.62;\n  float bottomWidth = edgeWidth * 1.22;\n  float topLine = 1.0 - smoothstep(topWidth * 0.12, topWidth, topDistance);\n  float bottomLine = 1.0 - smoothstep(bottomWidth * 0.12, bottomWidth, bottomDistance);\n  float topSpread = pow(1.0 - smoothstep(0.0, 1.12, topDistance), 0.72);\n  float bottomSpread = pow(1.0 - smoothstep(0.0, 1.12, bottomDistance), 0.72);\n  float edgeSpread = max(topSpread, bottomSpread);\n  float rim = pow(1.0 - abs(dot(normalize(v_normal), normalize(v_viewDir))), 3.0);\n  float highlight = ((topLine * 1.08 + bottomLine * 1.32) * 1.35 + edgeSpread * 0.72 + rim * 0.02) * fade * flashStrength;\n  vec3 color = baseColor.rgb + flashColor.rgb * highlight;\n  return CCFragOutput(vec4(color, baseColor.a));\n}\nlayout(location = 0) out vec4 cc_FragColor;\nvoid main() { cc_FragColor = frag(); }"
                    },
                    "glsl1": {
                        "vert": "\nprecision highp float;\nuniform highp mat4 cc_matView;\n  uniform highp mat4 cc_matProj;\n  uniform highp vec4 cc_cameraPos;\nuniform highp mat4 cc_matWorld;\n  uniform highp mat4 cc_matWorldIT;\nattribute vec3 a_position;\nattribute vec3 a_normal;\nattribute vec2 a_texCoord;\nvarying vec2 v_uv;\nvarying float v_worldY;\nvarying vec3 v_normal;\nvarying vec3 v_viewDir;\nvoid main () {\n  vec4 world = cc_matWorld * vec4(a_position, 1.0);\n  v_uv = a_texCoord;\n  v_worldY = world.y;\n  v_normal = normalize((cc_matWorldIT * vec4(a_normal, 0.0)).xyz);\n  v_viewDir = normalize(cc_cameraPos.xyz - world.xyz);\n  gl_Position = cc_matProj * cc_matView * world;\n}",
                        "frag": "\nprecision highp float;\nvec4 CCFragOutput (vec4 color) {\n  return color;\n}\nuniform sampler2D mainTexture;\n   uniform vec4 mainColor;\n   uniform vec4 flashColor;\n   uniform float flashProgress;\n   uniform float flashStrength;\n   uniform float edgeWidth;\n   uniform float worldCenterY;\n   uniform float worldHalfY;\nvarying vec2 v_uv;\nvarying float v_worldY;\nvarying vec3 v_normal;\nvarying vec3 v_viewDir;\nvec4 frag () {\n  float p = clamp(flashProgress, 0.0, 1.0);\n  float fade = 1.0 - smoothstep(0.12, 1.0, p);\n  vec4 baseColor = texture2D(mainTexture, v_uv) * mainColor;\n  float halfY = max(worldHalfY, 0.001);\n  float yN = clamp((v_worldY - worldCenterY) / halfY, -1.0, 1.0);\n  float topDistance = clamp(1.0 - yN, 0.0, 1.0);\n  float bottomDistance = clamp(1.0 + yN, 0.0, 1.0);\n  float topWidth = edgeWidth * 0.62;\n  float bottomWidth = edgeWidth * 1.22;\n  float topLine = 1.0 - smoothstep(topWidth * 0.12, topWidth, topDistance);\n  float bottomLine = 1.0 - smoothstep(bottomWidth * 0.12, bottomWidth, bottomDistance);\n  float topSpread = pow(1.0 - smoothstep(0.0, 1.12, topDistance), 0.72);\n  float bottomSpread = pow(1.0 - smoothstep(0.0, 1.12, bottomDistance), 0.72);\n  float edgeSpread = max(topSpread, bottomSpread);\n  float rim = pow(1.0 - abs(dot(normalize(v_normal), normalize(v_viewDir))), 3.0);\n  float highlight = ((topLine * 1.08 + bottomLine * 1.32) * 1.35 + edgeSpread * 0.72 + rim * 0.02) * fade * flashStrength;\n  vec3 color = baseColor.rgb + flashColor.rgb * highlight;\n  return CCFragOutput(vec4(color, baseColor.a));\n}\nvoid main() { gl_FragColor = frag(); }"
