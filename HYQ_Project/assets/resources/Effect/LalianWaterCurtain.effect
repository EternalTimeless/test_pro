CCEffect %{
  techniques:
  - passes:
    - vert: water-vs:vert
      frag: water-fs:frag
      rasterizerState:
        cullMode: none
      depthStencilState:
        depthTest: true
        depthWrite: false
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
          blendSrcAlpha: one
          blendDstAlpha: one_minus_src_alpha
      properties:
        mainColor:      { value: [0.05, 0.55, 1.0, 1.0], editor: { type: color } }
        deepColor:      { value: [0.02, 0.12, 0.85, 1.0], editor: { type: color } }
        highlightColor: { value: [0.65, 0.95, 1.0, 1.0], editor: { type: color } }
        flowSpeed:      { value: 1.8 }
        flowDensity:    { value: 7.0 }
        opacity:        { value: 0.9 }
}%

CCProgram water-vs %{
  precision highp float;
  #include <cc-global>
  #include <cc-local>
  in vec3 a_position;
  in vec2 a_texCoord;
  out vec2 v_uv;

  vec4 vert () {
    v_uv = a_texCoord;
    return cc_matProj * cc_matView * cc_matWorld * vec4(a_position, 1.0);
  }
}%

CCProgram water-fs %{
  precision highp float;
  #include <cc-global>
  #include <output>

  in vec2 v_uv;
  uniform WaterParams {
    vec4 mainColor;
    vec4 deepColor;
    vec4 highlightColor;
    float flowSpeed;
    float flowDensity;
    float opacity;
  };

  float hash21(vec2 p) {
    p = fract(p * vec2(123.34, 456.21));
    p += dot(p, p + 45.32);
    return fract(p.x * p.y);
  }

  float flowingLine(float x, float y, float seed, float width) {
    float bend = sin(y * 7.0 + seed * 5.3) * 0.025 + sin(y * 15.0 + seed) * 0.012;
    return 1.0 - smoothstep(width, width * 2.8, abs(x + bend));
  }

  vec4 frag () {
    float time = cc_time.x * flowSpeed;
    vec2 uv = v_uv;
    float fallingY = uv.y + time;

    float cellX = floor(uv.x * flowDensity);
    float localX = fract(uv.x * flowDensity) - 0.5;
    float seed = hash21(vec2(cellX, 3.17));
    float line = flowingLine(localX, fallingY, seed, 0.035 + seed * 0.055);
    float segment = smoothstep(0.08, 0.42, sin((fallingY + seed) * (8.0 + seed * 7.0)) * 0.5 + 0.5);
    float fineLine = flowingLine(localX + 0.18 * sin(seed * 9.0), fallingY * 1.45, seed + 2.1, 0.018);
    float waterFlow = line * (0.4 + segment * 0.8) + fineLine * 0.42;

    float broadWave = sin(uv.x * 18.0 + fallingY * 2.2) * 0.5 + 0.5;
    broadWave *= sin(uv.x * 31.0 - fallingY * 3.1) * 0.5 + 0.5;
    float bottomGlow = pow(1.0 - uv.y, 4.0);
    float sideGlow = pow(1.0 - abs(uv.x * 2.0 - 1.0), 0.35);
    float topFade = smoothstep(0.0, 0.18, uv.y) * (1.0 - smoothstep(0.88, 1.0, uv.y) * 0.45);

    vec3 color = mix(deepColor.rgb, mainColor.rgb, 0.34 + broadWave * 0.34);
    color = mix(color, highlightColor.rgb, clamp(waterFlow * 0.9 + bottomGlow * 0.82, 0.0, 1.0));
    color = min(color * (1.08 + waterFlow * 0.16), vec3(1.0));
    float alpha = opacity * topFade * (0.52 + broadWave * 0.18 + waterFlow * 0.38 + bottomGlow * 0.42);
    alpha *= 0.72 + sideGlow * 0.28;
    return CCFragOutput(vec4(color, clamp(alpha, 0.0, 0.95)));
  }
}%
