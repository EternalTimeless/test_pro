CCEffect %{
  techniques:
  - name: transparent
    passes:
    - vert: oil-burst-vs
      frag: oil-burst-fs:frag
      rasterizerState:
        cullMode: none
      depthStencilState:
        depthTest: true
        depthWrite: false
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
          blendDstAlpha: one_minus_src_alpha
      properties:
        mainTexture:    { value: white }
        mainColor:      { value: [1, 1, 1, 1], editor: { type: color } }
        crackColor:     { value: [1, 0.32, 0.06, 1], editor: { type: color } }
        edgeColor:      { value: [1, 0.9, 0.2, 1], editor: { type: color } }
        burstProgress:  { value: 0.0, editor: { slide: true, range: [0, 1, 0.001] } }
        burstWidth:     { value: 0.12, editor: { slide: true, range: [0.01, 0.4, 0.001] } }
        burstOffset:    { value: 0.35, editor: { slide: true, range: [0, 1.5, 0.001] } }
}%

CCProgram oil-burst-vs %{
  precision highp float;

  #include <cc-global>
  #include <cc-local>

  in vec3 a_position;
  in vec3 a_normal;
  in vec2 a_texCoord;

  out vec2 v_uv;
  out vec3 v_worldPos;
  out vec3 v_worldNormal;

  uniform BurstParams {
    vec4 mainColor;
    vec4 crackColor;
    vec4 edgeColor;
    float burstProgress;
    float burstWidth;
    float burstOffset;
  };

  float hash31(vec3 p) {
    return fract(sin(dot(p, vec3(12.9898, 78.233, 37.719))) * 43758.5453);
  }

  void main () {
    float p = clamp(burstProgress, 0.0, 1.0);
    float shard = hash31(floor(a_position.xyz * 5.0));
    float lift = burstOffset * p * p * (0.35 + shard);
    vec3 localPos = a_position + normalize(a_normal) * lift;

    vec4 world = cc_matWorld * vec4(localPos, 1.0);
    v_worldPos = world.xyz;
    v_worldNormal = normalize((cc_matWorldIT * vec4(a_normal, 0.0)).xyz);
    v_uv = a_texCoord;

    gl_Position = cc_matProj * cc_matView * world;
  }
}%

CCProgram oil-burst-fs %{
  precision highp float;
  #include <output>

  uniform sampler2D mainTexture;

  uniform BurstParams {
    vec4 mainColor;
    vec4 crackColor;
    vec4 edgeColor;
    float burstProgress;
    float burstWidth;
    float burstOffset;
  };

  in vec2 v_uv;
  in vec3 v_worldPos;
  in vec3 v_worldNormal;

  float hash21(vec2 p) {
    return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);
  }

  float crackNoise(vec2 uv) {
    vec2 grid = floor(uv);
    vec2 f = fract(uv);
    float a = hash21(grid);
    float b = hash21(grid + vec2(1.0, 0.0));
    float c = hash21(grid + vec2(0.0, 1.0));
    float d = hash21(grid + vec2(1.0, 1.0));
    vec2 u = f * f * (3.0 - 2.0 * f);
    return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);
  }

  vec4 frag () {
    float p = clamp(burstProgress, 0.0, 1.0);
    vec2 crackUv = v_uv * 10.0 + v_worldPos.xz * 0.08;
    float n = crackNoise(crackUv);

    if (n < p) {
      discard;
    }

    vec4 baseColor = texture(mainTexture, v_uv) * mainColor;
    float edge = 1.0 - smoothstep(0.0, max(0.001, burstWidth), n - p);
    float facing = 0.55 + abs(v_worldNormal.y) * 0.25;
    vec3 burstColor = mix(baseColor.rgb * facing, crackColor.rgb, edge * 0.85);
    burstColor += edgeColor.rgb * edge * 0.55;

    float alpha = baseColor.a * (1.0 - smoothstep(0.82, 1.0, p));
    return CCFragOutput(vec4(burstColor, alpha));
  }
}%
