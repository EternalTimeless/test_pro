CCEffect %{
  techniques:
  - name: transparent
    passes:
    - vert: oil-burst-vs
      frag: oil-burst-fs:frag
      rasterizerState:
        cullMode: none
      depthStencilState:
        depthTest: true
        depthWrite: false
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
          blendDstAlpha: one_minus_src_alpha
      properties:
        mainTexture:    { value: white }
        mainColor:      { value: [1, 1, 1, 1], editor: { type: color } }
        crackColor:     { value: [0.86, 0.92, 1, 1], editor: { type: color } }
        edgeColor:      { value: [1, 1, 1, 1], editor: { type: color } }
        burstProgress:  { value: 0.0, editor: { slide: true, range: [0, 1, 0.001] } }
        burstWidth:     { value: 0.04, editor: { slide: true, range: [0.005, 0.2, 0.001] } }
        burstOffset:    { value: 0.22, editor: { slide: true, range: [0, 0.6, 0.001] } }
}%

CCProgram oil-burst-vs %{
  precision highp float;

  #include <cc-global>
  #include <cc-local>

  in vec3 a_position;
  in vec3 a_normal;
  in vec2 a_texCoord;

  out vec2 v_uv;
  out vec3 v_worldPos;
  out float v_shardSeed;

  uniform BurstParams {
    vec4 mainColor;
    vec4 crackColor;
    vec4 edgeColor;
    float burstProgress;
    float burstWidth;
    float burstOffset;
  };

  float hash21(vec2 p) {
    return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);
  }

  void main () {
    float p = clamp(burstProgress, 0.0, 1.0);
    vec2 shardCell = floor(a_texCoord * 4.0 + a_position.xz * 0.06);
    float shard = hash21(shardCell);
    float angle = hash21(shardCell + vec2(17.0, 29.0)) * 6.2831853;
    vec3 scatterDir = normalize(vec3(cos(angle) * 0.55, 0.28 + shard * 0.22, sin(angle) * 0.55) + a_normal * 0.45);
    float scatter = burstOffset * p * p * (0.45 + shard * 0.55);
    vec3 localPos = a_position + scatterDir * scatter;

    vec4 world = cc_matWorld * vec4(localPos, 1.0);
    v_worldPos = world.xyz;
    v_uv = a_texCoord;
    v_shardSeed = shard;

    gl_Position = cc_matProj * cc_matView * world;
  }
}%

CCProgram oil-burst-fs %{
  precision highp float;
  #include <output>

  uniform sampler2D mainTexture;

  uniform BurstParams {
    vec4 mainColor;
    vec4 crackColor;
    vec4 edgeColor;
    float burstProgress;
    float burstWidth;
    float burstOffset;
  };

  in vec2 v_uv;
  in vec3 v_worldPos;
  in float v_shardSeed;

  float hash21(vec2 p) {
    return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);
  }

  float shardCrack(vec2 uv) {
    vec2 grid = floor(uv);
    vec2 f = fract(uv);
    float jitter = hash21(grid) - 0.5;
    float border = min(min(f.x, 1.0 - f.x), min(f.y, 1.0 - f.y));
    float diagA = abs(f.x - f.y + jitter * 0.28);
    float diagB = abs(f.x + f.y - 1.0 + jitter * 0.22);
    return min(border, min(diagA, diagB));
  }

  vec4 frag () {
    float p = clamp(burstProgress, 0.0, 1.0);
    vec4 baseColor = texture(mainTexture, v_uv) * mainColor;

    vec2 crackUv = v_uv * 4.0 + v_worldPos.xz * 0.03;
    float crack = shardCrack(crackUv);
    float crackWidth = burstWidth * smoothstep(0.04, 0.75, p);
    float brokenCell = step(0.78, p) * step(0.62, v_shardSeed);

    if ((p > 0.01 && crack < crackWidth) || brokenCell > 0.5) {
      discard;
    }

    float edge = 1.0 - smoothstep(crackWidth, crackWidth + 0.018, crack);
    edge *= smoothstep(0.04, 0.75, p);
    vec3 shardColor = baseColor.rgb;
    shardColor = mix(shardColor, crackColor.rgb, edge * 0.28);
    shardColor += edgeColor.rgb * edge * 0.14;

    float alpha = baseColor.a * (1.0 - smoothstep(0.9, 1.0, p) * 0.35);
    return CCFragOutput(vec4(shardColor, alpha));
  }
}%
